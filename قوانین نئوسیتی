<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>NeoCity Rules</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Vazirmatn", sans-serif;
    }

    body {
      transition: background-color 1s ease, color 1s ease;
      min-height: 100vh;
      padding: 20px;
      position: relative;
      overflow-x: hidden;
    }

    /* حالت روز */
    body.day {
      background: linear-gradient(to bottom, #87ceeb, #e0f7fa);
      color: #003366;
    }

    /* حالت شب */
    body.night {
      background: linear-gradient(to bottom, #0b0c2a, #1c1c3a);
      color: #f0f8ff;
    }

    /* عنصر مرکزی */
    .header {
      text-align: center;
      margin: 40px 0;
      position: relative;
      z-index: 10;
    }

    .header h1 {
      font-size: 2.8rem;
      font-weight: bold;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    /* دکمه سوئیچ */
    .theme-toggle {
      position: absolute;
      top: 20px;
      left: 20px;
      background: none;
      border: 2px solid;
      border-radius: 50%;
      width: 50px;
      height: 50px;
      cursor: pointer;
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.4s ease;
    }

    body.day .theme-toggle {
      background-color: #fff3cd;
      border-color: #ffd700;
      color: #ff8c00;
    }

    body.night .theme-toggle {
      background-color: #2c2c54;
      border-color: #a29bfe;
      color: #f1c40f;
    }

    /* قوانین */
    .rules {
      max-width: 800px;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.85);
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(5px);
      z-index: 10;
      position: relative;
    }

    body.night .rules {
      background: rgba(30, 30, 50, 0.85);
      color: #e0e0ff;
    }

    .rules h2 {
      margin-bottom: 20px;
      font-size: 1.6rem;
      text-align: center;
    }

    .rules ul {
      padding-right: 20px;
      list-style-type: "• ";
    }

    .rules li {
      margin: 12px 0;
      line-height: 1.6;
    }

    /* عناصر دکوراتیو: خورشید، ماه، ابر، ستاره */
    .sun, .moon, .cloud, .star {
      position: absolute;
      z-index: 1;
    }

    .sun {
      top: 60px;
      right: 60px;
      font-size: 5rem;
      color: #ffd700;
      text-shadow: 0 0 20px rgba(255, 215, 0, 0.7);
      opacity: 1;
      transition: opacity 1s ease;
    }

    body.night .sun {
      opacity: 0;
    }

    .moon {
      top: 80px;
      right: 80px;
      font-size: 4rem;
      color: #f1c40f;
      text-shadow: 0 0 20px rgba(241, 196, 15, 0.6);
      opacity: 0;
      transition: opacity 1s ease;
    }

    body.night .moon {
      opacity: 1;
    }

    .cloud {
      top: 100px;
      left: 10%;
      font-size: 3rem;
      color: white;
      opacity: 0.9;
    }

    body.night .cloud {
      opacity: 0.2;
    }

    .star {
      color: white;
      font-size: 1.2rem;
      opacity: 0;
    }

    body.night .star {
      opacity: 1;
    }

    /* ساخت ستاره‌ها به صورت رندوم */
    @keyframes twinkle {
      0%, 100% { opacity: 0.2; }
      50% { opacity: 1; }
    }

    .star:nth-child(odd) {
      animation: twinkle 3s infinite;
    }

    .star:nth-child(even) {
      animation: twinkle 2.5s infinite;
    }

    /* فونت فارسی */
    @import url('https://v1.fontapi.ir/css/Vazirmatn');
  </style>
</head>
<body class="day">
  <!-- دکمه تغییر تم -->
  <button class="theme-toggle" id="themeToggle">☀️</button>

  <!-- عنصرهای دکوراتیو -->
  <div class="sun">☀️</div>
  <div class="moon">🌙</div>
  <div class="cloud">☁️</div>

  <!-- ستاره‌ها (تولید شده در جاوااسکریپت) -->
  <div id="stars"></div>

  <!-- هدر -->
  <div class="header">
    <h1>NeoCity Rules</h1>
  </div>

  <!-- قوانین -->
  <div class="rules">
    <h2>قوانین سرور نئوسیتی به این قرار می باشد:</h2>
    <ul>
      <li>هرگونه فحاشی یا توهین برخورد جدی دارد</li>
      <li>لطفا از ایجاد صدا های نا حنجار خودداری کنید (مایک بوست)</li>
      <li>لطفاً در سرور آهنگ های بی ادبی یا چیز های رکیک نذارید</li>
      <li>لطفاً برای عضویت در شغلی حتماً در دیسکورد جاب و دیسکورد اصلی جوین باشید؛ اگر نباشید هم با لیدر هم با شما برخورد می‌شود</li>
      <li>لطفاً موقعی که به تستی می‌روید خوب قوانین را بخوانید تا دچار مشکلی نشوید</li>
      <li>در صورتی که اکانت خود را در اختیار کسی بگذارید و به شما پس ندهد، سرور هیچ مسئولیتی را قبول نمی‌کند</li>
      <li>لطفاً از سوُاستفا (ابیوز) از قدرت‌هایی که در اختیار شما گذاشته شده خودداری کنید</li>
      <li>در صورت اتک دادن به سرور و سعی بر آن، بن آی‌پی می‌شوید و پیگیری قانونی به همراه دارد</li>
    </ul>
    <p style="margin-top: 20px; text-align: center; font-weight: bold;">
      لطفاً قوانین را خوب مطالعه کنید که دچار مشکلی نشوید
    </p>
  </div>

  <script>
    // تولید ستاره‌های رندوم برای شب
    const starsContainer = document.getElementById('stars');
    for (let i = 0; i < 100; i++) {
      const star = document.createElement('div');
      star.classList.add('star');
      star.innerHTML = '⭐';
      star.style.top = Math.random() * 100 + 'vh';
      star.style.left = Math.random() * 100 + 'vw';
      star.style.fontSize = (Math.random() * 1 + 0.5) + 'rem';
      starsContainer.appendChild(star);
    }

    // سوئیچ تم
    const themeToggle = document.getElementById('themeToggle');
    const body = document.body;

    themeToggle.addEventListener('click', () => {
      if (body.classList.contains('day')) {
        body.classList.replace('day', 'night');
        themeToggle.textContent = '🌙';
      } else {
        body.classList.replace('night', 'day');
        themeToggle.textContent = '☀️';
      }
    });
  </script>
</body>
</html>
